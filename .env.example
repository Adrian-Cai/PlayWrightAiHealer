# Example environment for Playwright AI Healer.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Full instructions: see `.env` comments or AGENTS.md §运行时环境变量.

# [必需] AI 候选定位器（DeepSeek 优先，OpenAI 回退）
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# [真机飞书验证必需] 自建应用三件套
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# [可选] 卡片回调共享密钥: openssl rand -hex 32
HEALER_CALLBACK_TOKEN=

# [可选] lark=国际版，留空=国内飞书
# FEISHU_DOMAIN=lark

# [可选] Jenkins / 报告链接
# JENKINS_BUILD_URL=
# PLAYWRIGHT_REPORT_URL=
# [可选] 飞书链接预览匹配 Jenkins 报告链接时使用的外网根地址；不填默认 https://jenkins.wiac.xyz/
# JENKINS_PUBLIC_URL=https://jenkins.wiac.xyz/

# [可选] 运行标识
# RUN_ID=

# [Optional] Create a CNB PR after a Feishu approval.
# Default is off so local healing and review proposals stay decoupled from git/CI.
# HEALER_AUTO_PR=true
